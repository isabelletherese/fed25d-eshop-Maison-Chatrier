# Supabase Postgres connection string from the project's Connect dialog.
# Keep the database password server-side.
DATABASE_URL=

# Supabase project URL and publishable key for Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Customer created manually in Supabase Authentication with Auto Confirm User.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional override when Next.js is running on a different port.
TEST_BASE_URL=http://localhost:3000
